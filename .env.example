# 飞书自建应用机器人；不要在此示例文件填写真实密钥。
LARK_APP_ID=
LARK_APP_SECRET=
# 火山方舟模型或推理接入点 ID，需支持 Function Calling。
ARK_API_KEY=
ARK_MODEL=
ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
# 多维表格 /base/ 后面的 token 和 URL 的 table 参数。
BITABLE_BASE_TOKEN=
BITABLE_TABLE_ID=
# 可选：URL 的 view 参数。填写时保留视图筛选范围；留空查询整张表。
BITABLE_VIEW_ID=
# 这里配置字段名称（不是 field_id），须与实际表头一致。
BITABLE_DATE_FIELD=记账日期
BITABLE_AMOUNT_FIELD=金额
BITABLE_DESCRIPTION_FIELD=具体
# CLI 使用自己保存的登录态，与机器人凭证独立。
LARK_CLI_PATH=lark-cli
LARK_CLI_IDENTITY=user
CLI_TIMEOUT_SECONDS=30
AGENT_TIMEOUT_SECONDS=90
DISPLAY_TIMEZONE=Asia/Shanghai
