# 飞书自建应用机器人；不要在此示例文件填写真实密钥。
LARK_APP_ID=
LARK_APP_SECRET=
# 火山方舟模型或推理接入点 ID，需支持 Function Calling。
ARK_API_KEY=
ARK_MODEL=
ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
# 多维表格 /base/ 后面的 token 和 URL 的 table 参数。
BITABLE_BASE_TOKEN=
BITABLE_TABLE_ID=
# 可选：仅 --query 只读诊断使用视图范围；记账和历史分类检索针对整张表。
BITABLE_VIEW_ID=
# 这里配置字段名称（不是 field_id），须与实际表头一致。
BITABLE_DATE_FIELD=记账日期
BITABLE_AMOUNT_FIELD=金额
BITABLE_DESCRIPTION_FIELD=具体
# CLI 使用自己保存的登录态，与机器人凭证独立。
LARK_CLI_PATH=lark-cli
LARK_CLI_IDENTITY=user
CLI_TIMEOUT_SECONDS=30
# 仅约束模型理解阶段；已提交的写入由 CLI_TIMEOUT_SECONDS 单独约束。
AGENT_TIMEOUT_SECONDS=90
DISPLAY_TIMEZONE=Asia/Shanghai
# 系统提示词由用户提供；文件缺失或为空时 Agent 不启动。
AGENT_SYSTEM_PROMPT_PATH=prompts/system.md
# 分类知识及现有表格结构；相对路径均基于启动目录。
CATEGORIES_PATH=knowledge/categories.json
RULES_PATH=knowledge/rules.json
SCHEMA_PATH=knowledge/schema.json
# 明确的长期偏好单独保存，不覆盖原始分类规则。
PREFERENCES_PATH=knowledge/preferences.json
# 写入前保存消息 ID；请保留此文件以防重启后重复记账。
OPERATION_JOURNAL_PATH=.runtime/operations.json
# 运行日志同时输出到终端和文件；自动创建父目录，并追加到已有文件。
LOG_FILE_PATH=logs/service.log
# 每条消息的完整调试日志；同一消息重投递或重启后追加到同一个文件。
MESSAGE_LOG_DIR=logs
# 即时纠错和追问上下文有效期，单位：秒。
CONTEXT_TTL_SECONDS=1800
BITABLE_CATEGORY1_FIELD=一级分类
BITABLE_CATEGORY2_FIELD=二级分类
BITABLE_CATEGORY3_FIELD=三级分类
